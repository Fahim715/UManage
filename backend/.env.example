DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Generate a unique value with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN="1h"
PORT=4000
CORS_ORIGIN="http://localhost:4200"
# Required only when running the development-only seed script. Set unique local
# values; never reuse production credentials.
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_EMPLOYEE1_PASSWORD=
SEED_EMPLOYEE2_PASSWORD=
